# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/crispo

# NextAuth (JWT secret - generate with: openssl rand -base64 32)
# IMPORTANT: This must be a stable secret that does NOT change between
# deployments, or existing admin sessions will be invalidated.
NEXTAUTH_SECRET=your-jwt-secret

# On Vercel DO NOT set NEXTAUTH_URL (NextAuth infers the request origin and
# uses VERCEL_URL automatically). A value of http://localhost:3000 in the
# production runtime breaks admin login with a "Server error / server
# configuration" page. Set it ONLY when running locally:
NEXTAUTH_URL=http://localhost:3000

# Admin credentials (used for the NextAuth CredentialsProvider login)
ADMIN_EMAIL=admin@crispo.com
ADMIN_PASSWORD=change-this-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay (server-side keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay (public key - exposed to the browser for the checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
