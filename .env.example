# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/crispo

# NextAuth (JWT secret - generate with: openssl rand -base64 32)
# IMPORTANT: This must be a stable secret that does NOT change between
# deployments, or existing admin sessions will be invalidated.
NEXTAUTH_SECRET=your-jwt-secret

# On Vercel DO NOT set NEXTAUTH_URL (NextAuth infers the request origin and
# uses VERCEL_URL automatically). A value of http://localhost:3000 in the
# production runtime breaks admin login with a "Server error / server
# configuration" page. Set it ONLY when running locally:
NEXTAUTH_URL=http://localhost:3000

# Admin credentials (used for the NextAuth CredentialsProvider login)
ADMIN_EMAIL=admin@crispo.com
ADMIN_PASSWORD=change-this-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay (server-side keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay (public key - exposed to the browser for the checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Delhivery One (prepaid e-commerce shipping)
# Server-side ONLY — never expose via NEXT_PUBLIC_* and never commit the real
# token. Get a production token from the Delhivery One developer portal.
DELHIVERY_API_TOKEN=your-production-delhivery-token
# Optional: staging host swap for testing.
# DELHIVERY_API_BASE=https://staging-express.delhivery.com
# Registered warehouse / pickup location name (exactly as configured).
DELHIVERY_PICKUP_LOCATION=your-warehouse-name
# Warehouse origin pincode (used for rate + serviceability).
DELHIVERY_ORIGIN_PINCODE=your-origin-pincode
# Surface ("S") or Express ("E") shipping mode, default S.
# DELHIVERY_SHIPPING_MODE=S
# GST fields sent on each shipment (recommended for prepaid).
# DELHIVERY_SELLER_GST_TIN=
# DELHIVERY_HSN_CODE=
# Optional default pickup request time (HH:MM:SS), default 10:00:00.
# DELHIVERY_PICKUP_TIME=10:00:00

# Webhook auth token for the /api/webhooks/delhivery Scan Push endpoint.
# Register this endpoint in the Delhivery One portal with an Authorization
# header equal to this value. Endpoint returns 401 until it is set.
# DELHIVERY_WEBHOOK_TOKEN=

# Secret used by the auto-retry cron (/api/cron/sync-delhivery). Vercel
# injects it as "Authorization: Bearer <CRON_SECRET>" when the cron runs.
CRON_SECRET=your-cron-secret
